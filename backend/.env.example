# Free-tier LLM API keys for freelm (all optional; comma-separate multiple keys for rotation)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Set to 1 to allow keyless public endpoints (Kilo Gateway, OVHcloud) when no API keys are set
FREELM_KEYLESS=0

# Storage & Workspace Paths
DATA_DIR=./data
QDRANT_URL=
QDRANT_API_KEY=<your-qdrant-api-key>
DATABASE_URL=sqlite+aiosqlite:///./data/repoguru.db

# Ingestion Safety Limits
CLONE_TIMEOUT_SECONDS=90
MAX_REPO_SIZE_MB=250
MAX_FILE_COUNT=2500

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
