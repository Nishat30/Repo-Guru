# Optional: full backend base URL for separate production hosting (e.g. https://api.repoguru.app)
# Leave empty in local dev or Docker Compose to use the /api dev proxy
VITE_API_BASE_URL=

# Vite dev server proxy target (http://127.0.0.1:8000 locally, http://backend:8000 in Docker)
VITE_PROXY_TARGET=http://127.0.0.1:8000

